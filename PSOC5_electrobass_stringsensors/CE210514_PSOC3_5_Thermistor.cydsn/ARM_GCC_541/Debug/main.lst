 252:main.c        **** float   LEAF_clip(float min, float val, float max)
 253:main.c        **** {
 254:main.c        ****     float tempmin = min;
 255:main.c        ****     float tempmax = max;
 256:main.c        ****     if (min > max)
 257:main.c        ****     {
 258:main.c        ****         tempmin = max;
 259:main.c        ****         tempmax = min;
 260:main.c        ****     }
 261:main.c        ****     if (val < tempmin)
 262:main.c        ****     {
 263:main.c        ****         return tempmin;
 264:main.c        ****     }
 265:main.c        ****     else if (val > tempmax)
 266:main.c        ****     {
 267:main.c        ****         return tempmax;
 268:main.c        ****     }
 269:main.c        ****     else
 270:main.c        ****     {
 271:main.c        ****         return val;
 272:main.c        ****     }
 273:main.c        **** }
 274:main.c        **** float mtof(float f)
 275:main.c        **** {
 276:main.c        ****     if (f <= -1500.0f) return(0);
 277:main.c        ****     else if (f > 1499.0f) return(mtof(1499.0f));
 278:main.c        ****     else return (8.17579891564f * expf(0.0577622650f * f));
 279:main.c        **** }
 280:main.c        **** 
 281:main.c        **** float ftom(float f)
 282:main.c        **** {
 283:main.c        ****     return (f > 0 ? 17.3123405046f * logf(.12231220585f * f) : -1500.0f);
 284:main.c        **** }
 285:main.c        **** 
 286:main.c        **** // alpha, [0.0, 1.0]
 287:main.c        **** float LEAF_interpolation_linear (float A, float B, float alpha)
 288:main.c        **** {
 289:main.c        ****     float omAlpha = 1.0f - alpha;
 290:main.c        ****     
 291:main.c        ****     // First 1/2 of interpolation
 292:main.c        ****     float out = A * omAlpha;
 293:main.c        ****     
 294:main.c        ****     out += B * alpha;
 295:main.c        ****     
 296:main.c        ****     return out;
 297:main.c        **** }
